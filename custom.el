;;; -*- lexical-binding: t -*-
(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(company-show-quick-access t nil nil "Customized with use-package company")
 '(haskell-hoogle-command nil)
 '(package-selected-packages
   '(ace-window cmake-mode color-theme-modern company-statistics dired-hacks-utils
				dired-preview exwm f gh-md go-mode haskell-mode ht lua-mode lv
				magit-gh marginalia markdown-mode neato-graph-bar
				nerd-icons-completion nerd-icons-corfu nerd-icons-dired
				orderless organic-green-theme persist php-mode spinner
				standard-themes yasnippet-snippets))
 '(tab-bar-mode t)
 '(tool-bar-mode nil))
(custom-set-faces
 ;; custom-set-faces was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(default ((t (:family "Hasklug Nerd Font Propo" :foundry "ADBO" :slant normal :weight bold :height 120 :width normal))))
 '(fill-column-indicator ((t (:foreground "#CCCCCC" :weight normal))))
 '(multi-magit-repo-heading ((t (:inherit magit-section-heading :box nil))))
 '(speedbar-selected-face ((t (:foreground "#119011" :underline t)))))
